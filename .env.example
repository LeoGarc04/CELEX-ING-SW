# Copy to .env (ignored by Git). The application reads environment variables.
# .env is not loaded automatically: export variables in the launch environment.
DB_URL=jdbc:mysql://localhost:3306/celex
DB_USER=
DB_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_TLS=true
MAIL_FROM=
# Explicit comma-separated authorized domains; never a wildcard.
IPN_DOMAINS=alumno.ipn.mx
FEE_IPN=620.00
FEE_PUBLIC=1280.00
CELEX_STORAGE=./storage
PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
BACKUP_ENABLED=true
BACKUP_DATABASE=celex
BACKUP_DIRECTORY=./backups
CELEX_HOLIDAYS=
MAIL_DAILY_LIMIT=400
